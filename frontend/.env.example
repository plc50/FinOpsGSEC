# Base URL of the FinOps backend proxy. Default is http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# Use the typed mock/fixture layer instead of a live backend.
# Set to "true" to demo/test the UI without a running backend.
VITE_USE_MOCKS=false

# Expose known consumer demo-key shortcuts in non-development builds.
# Leave false for normal production builds; manually entered pitch keys stay in memory only.
VITE_ENABLE_DEMO_KEYS=false
