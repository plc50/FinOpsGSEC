# Copy to .env and adjust as needed.

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://finops:finops@localhost:5432/finops
TEST_DATABASE_URL=postgresql+asyncpg://finops:finops@localhost:5432/finops_test

# Demo resilience: return realistic mock completions instead of calling real
# providers. Default false (real httpx pass-through to configured providers).
MOCK_PROVIDERS=false

# Provider credentials. These are injected server-side; clients only send the
# internal finops_key_* bearer tokens.
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
TABBY_API_KEY=76d0ce0ae9b8c89af02e239bf2bc08b4

# Outbound provider timeout in seconds.
PROVIDER_TIMEOUT=60
PROVIDER_CONNECT_TIMEOUT=5
PROVIDER_READ_TIMEOUT=120

# Best-effort category classifier. Deterministic rules run first; this model is
# only called when rule confidence is below the strong threshold.
CLASSIFIER_ENABLED=true
CLASSIFIER_PROVIDER=fireworks
CLASSIFIER_MODEL=accounts/fireworks/models/deepseek-v4-flash
CLASSIFIER_MAX_TOKENS=300

# Semantic cache (pgvector). Disabled automatically if the vector extension is
# unavailable in the connected PostgreSQL instance.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_AGE_SECONDS=604800
